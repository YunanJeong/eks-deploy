# =====================================================================
# Terraform 변수값 — 샘플 파일 (git 포함)
# =====================================================================

# [필수] EKS 클러스터 이름 — default 없음. 블루/그린 시 신규 이름 지정.
cluster_name = "my-eks-A"

# --- 태그 (모든 리소스에 일괄 적용) ---
# 기능상 영향 없이 사람이 콘솔에서 식별하기 위한 값. Terraform·Cluster 식별 키는 main.tf가 자동 부여하므로 여기선 나머지만 지정.
tags = {
  Name    = "my-eks-A"
  Owner   = "you@example.com"
  Service = "my-service"
}

# 배포 리전 (기본값: ap-northeast-2)
aws_region = "ap-northeast-2"

# Kubernetes 버전 — 블루/그린 업그레이드 시 이 값을 올림 (기본값: 1.36)
cluster_version = "1.36"

# 인증 모드 (기본값: API_AND_CONFIG_MAP = Access Entry + 레거시 ConfigMap 병행)
#   레거시 앱이 없으면 "API"(Access Entry 전용)로 좁힐 수 있음
authentication_mode = "API_AND_CONFIG_MAP"

# --- 네트워크 ---
# 기존 VPC 사용 시 vpc_id 지정(vpc_cidr 무시), 비우면 신규 생성.
# 기존 VPC 사용 시 subnet_ids 직접 지정. private 필수, public은 노드를 public에도 배치할 때만.
vpc_id             = ""
private_subnet_ids = []
public_subnet_ids  = []

# 신규 VPC 생성 시에만 사용되는 CIDR (기본값: 10.0.0.0/16)
vpc_cidr = "10.0.0.0/16"

# kubectl이 붙는 컨트롤플레인(API 서버) 엔드포인트의 접근 허용 IP. (노드 접근과 무관)
# 0.0.0.0/0이어도 접근엔 AWS 자격증명(액세스 키)+access entry 권한이 필요하므로 즉시 뚫리진 않음.
# ⚠️ 외부 공유 주의: 사무실/VPN 실제 IP가 드러남. 기본 전체 허용이라 운영은 좁힐 것.
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

# --- 노드 그룹 ---
instance_types          = ["t3.medium"]
node_group_min_size     = 1
node_group_desired_size = 2
node_group_max_size     = 3

# 노드 AMI 릴리스 버전. ""이면 최신 추종(새 AMI 나올 때 apply가 노드를 교체), 값 주면 고정.
node_ami_release_version = "" # 예: "1.36.0-20260714"

# --- 액세스 (클러스터 생성자 외 추가 멤버) ---
# key이름("iam_user_N")은 임의 라벨 - 자유롭게 짓고, 멤버 수만큼 항목을 늘림.
# policy_arn: .../AmazonEKSClusterAdminPolicy(전체관리) | AdminPolicy | EditPolicy | ViewPolicy(읽기)
# namespaces: 비우면 클러스터 전체, 채우면 해당 네임스페이스로 제한.
access_entries = {}
# access_entries = {
#   iam_user_0 = {
#     principal_arn = "arn:aws:iam::123456789012:user/someone"
#     policy_arn    = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
#     namespaces    = []
#   }
#   iam_user_1 = {
#     principal_arn = "arn:aws:iam::123456789012:user/another"
#     policy_arn    = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSViewPolicy"
#     namespaces    = []
#   }
# }
